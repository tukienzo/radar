# Radar — variables de entorno. Copiá este archivo a .env.local (local) y cargá las mismas en tu hosting (Vercel).
# Nunca subas .env.local al repo.

# ── Obligatorias ────────────────────────────────────────────────────────────────
# Supabase (proyecto nuevo): Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Contraseña para entrar al Radar (la elegís vos)
RADAR_PASSWORD=
# Secreto de los crons: cualquier texto largo al azar (Vercel lo manda como Bearer)
CRON_SECRET=
# Apify: console.apify.com → Settings → API & Integrations → Personal API token
APIFY_TOKEN=
# Claude (análisis, dossiers, fichas): console.anthropic.com → API keys
ANTHROPIC_API_KEY=

# ── Tu marca (Claude analiza todo en función de esto) ──────────────────────────
NEXT_PUBLIC_BRAND_NAME=Mi marca
# Tu cuenta de Instagram sin @ (base de comparación; no se recrea)
NEXT_PUBLIC_BRAND_IG_HANDLE=
# Palabra clave de tu CTA principal (la que la gente comenta o manda por DM)
NEXT_PUBLIC_BRAND_CTA_KEYWORD=INFO
RADAR_OFERTA=
RADAR_CLIENTE_IDEAL=
RADAR_MERCADO=
RADAR_REGLAS=
RADAR_MEZCLA=

# ── Transcripción (una de las dos; Groq es gratis) ─────────────────────────────
GROQ_API_KEY=
OPENAI_API_KEY=

# ── Instagram propio con métricas (opcional, Graph API) ─────────────────────────
IG_INSIGHTS_TOKEN=
IG_USER_ID=

# ── Ajustes (opcionales; estos son los valores por defecto) ────────────────────
# gratis = piezas lunes y jueves, sin historias (el plan gratuito de Apify no las permite)
# estandar = historias 2 veces por día, piezas lunes/miércoles/viernes · completo = todo a diario
RADAR_PLAN=estandar
# Tope de gasto por corrida de Apify, en USD
RADAR_TOPE_USD=3
RADAR_MODELO=claude-opus-5-5
RADAR_DIAS_PIEZAS=7
RADAR_PIEZAS_POR_CUENTA=15
